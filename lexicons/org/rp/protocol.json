{
  "lexicon": 1,
  "id": "org.rp.protocol",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "rootId",
          "version",
          "stage",
          "createdAt"
        ],
        "properties": {
          "rootId": { "type": "string" },
          "version": { "type": "string" },
          "stage": { "type": "string" },
          "date": { "type": "string" },
          "language": { "type": "string" },
          "provenance": {
            "type": "object",
            "properties": {
              "authorDid": { "type": "string" },
              "signature": { "type": "string" }
            }
          },
          "title": { "type": "string", "maxLength": 300 },
          "summary": { "type": "string", "maxLength": 3000 },
          "body": { "type": "string", "maxLength": 300000 },
          "subject": {
             "type": "object",
             "properties": {
                "subjectKind": { "type": "string" },
                "subjectRootId": { "type": "string" },
                "actorDid": { "type": "string" }
             }
          },
          "relations": {
             "type": "object",
             "properties": {
               "needId": { "type": "string" },
               "suiteIds": { "type": "array", "items": { "type": "string" } },
               "relatedProtocols": { "type": "array", "items": { "type": "string" } }
             }
          },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxLength": 10 },
          "connectivity": {
             "type": "object",
             "properties": {
                "shortUrl": { "type": "string" },
                "qrCode": { "type": "string" }
             }
          },
          "attribution": { "type": "array", "items": { "type": "unknown" } },
          "history": { "type": "array", "items": { "type": "unknown" } },
          "changeDescription": { "type": "string", "maxLength": 1000 },
          "endOfLifeAt": { "type": "string", "format": "datetime" },
          "archived": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
